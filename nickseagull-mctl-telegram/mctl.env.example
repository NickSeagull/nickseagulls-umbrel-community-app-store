# Copy to mctl.env at the FIXED app-data root before installing.
# Never commit the filled file; make it private to the Umbrel host.
TG_API_ID=
TG_API_HASH=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
PUBLIC_BASE_URL=https://your-telegram-mcp.example.com
# Numeric Telegram user ID of the OWNER; private allowlist, not a bot username.
TG_LOGIN_CLIENTS=
# Optional login-bot digest only; not required for OIDC:
# TELEGRAM_LOGIN_BOT_TOKEN=
