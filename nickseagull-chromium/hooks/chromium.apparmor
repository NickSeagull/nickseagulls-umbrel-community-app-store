# SPDX-License-Identifier: Apache-2.0
# Derived from Docker Engine 28.5.0 docker-default AppArmor template:
# https://github.com/moby/moby/blob/v28.5.0/vendor/github.com/moby/profiles/apparmor/template.go
# The only policy permission added is `userns create,` for Chromium's own sandbox.
#include <tunables/global>
profile nickseagull-chromium-docker28_5_0-userns-260904 flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  userns create,
  # Host processes and Docker runtime may signal browser processes.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  # Dockerd on the tested Umbrel host is unconfined (covered above).
  signal (send,receive) peer=nickseagull-chromium-docker28_5_0-userns-260904,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=nickseagull-chromium-docker28_5_0-userns-260904,
}
