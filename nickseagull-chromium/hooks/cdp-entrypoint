#!/bin/sh
# Copy the update-managed SSH policy before LinuxServer's /init builds sshd_config.
# A missing policy/key must never fall back to the image's persistent keys.
set -eu
if [ ! -s /key/cdp-sshd.conf ] || [ ! -s /key/ramsys.pub ] || \
   [ "$(wc -l < /key/ramsys.pub)" -ne 1 ] || \
   ! ssh-keygen -lf /key/ramsys.pub >/dev/null 2>&1; then
    printf '%s\n' 'CDP SSH policy or public key is missing/invalid' >&2
    exit 1
fi
# Regenerate the entire sshd configuration from the pinned image on every
# start. Persistent Match/Include directives must never weaken a policy check
# that was evaluated for a different Docker-network source address.
# Host identity lives separately in /config/ssh_host_keys and is retained.
rm -rf /config/sshd
mkdir -p /config/sshd/sshd_config.d
cp /key/cdp-sshd.conf /config/sshd/sshd_config.d/10-cdp-only.conf
chmod 644 /config/sshd/sshd_config.d/10-cdp-only.conf
cmp -s /key/cdp-sshd.conf /config/sshd/sshd_config.d/10-cdp-only.conf || exit 1
exec /init
